pipeline {
    agent any

    environment {
        DOCKER_PATH = 'C:\\Users\\STUDENT\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        DOCKER_USER = 'rohhh12'
        IMAGE_NAME = 'registry'
        CONTAINER_NAME = 'local-registry'
    }

    stages {

        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Application Build & Test') {
            steps {
                bat '"C:\\Users\\STUDENT\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m py_compile app.py'
            }
        }

        stage('3. Build & Tag Docker Image') {
            steps {
                bat '"%DOCKER_PATH%" --version'

                bat '"%DOCKER_PATH%" build -t %DOCKER_USER%/%IMAGE_NAME%:%BUILD_NUMBER% -t %DOCKER_USER%/%IMAGE_NAME%:latest .'
            }
        }

        stage('4. Push Image to Docker Hub') {
            steps {
                bat '"%DOCKER_PATH%" push %DOCKER_USER%/%IMAGE_NAME%:%BUILD_NUMBER%'
                bat '"%DOCKER_PATH%" push %DOCKER_USER%/%IMAGE_NAME%:latest'
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded! Image %DOCKER_USER%/%IMAGE_NAME%:latest was pushed to Docker Hub."
        }

        failure {
            echo "Pipeline failed. Check the console output."
        }
    }
}
