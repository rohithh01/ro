pipeline {
    agent any

    environment {
        IMAGE_NAME = "anil-demo-app"
        DOCKER_USER = "YOUR_DOCKERHUB_USERNAME"
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Application Build & Test') {
            steps {
                bat '"C:\\Users\\STUDENT\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m py_compile app.py'
            }
        }

        stage('3. Build & Tag Docker Image') {
            steps {
                bat 'docker build -t %DOCKER_USER%/%IMAGE_NAME%:%BUILD_NUMBER% -t %DOCKER_USER%/%IMAGE_NAME%:latest .'
            }
        }

        stage('4. Push Image to Docker Hub') {
            steps {
                bat 'docker push %DOCKER_USER%/%IMAGE_NAME%:%BUILD_NUMBER%'
                bat 'docker push %DOCKER_USER%/%IMAGE_NAME%:latest'
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded! Docker image was built, tagged and pushed to Docker Hub."
        }
    }
}
